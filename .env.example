# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Search Provider: 'duckduckgo' (free, no key needed), 'tavily' (optional), or 'mock' (offline test mode)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./research.db

# Agent Constraints & Execution Bounds
MAX_RESEARCH_LOOPS=4
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_PAGE_EXTRACT_CHARS=4500
ENABLE_REFLECTION_VERIFICATION=true

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true
